# CampusKart backend settings
# Copy this file to .env and edit it if needed.

# Local MongoDB (default)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=campuskart

# MongoDB Atlas example (uncomment and paste your connection string)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# HTTP port used by the Express server
PORT=8080

# Optional overrides (defaults shown)
# UPLOAD_DIR=D:\Documents\Projects\CampusKart\backend\uploads
# WEB_DIR=D:\Documents\Projects\CampusKart\frontend\dist

# Comma-separated frontend origins when the SPA runs on another origin.
# Leave empty for the combined deployment (Express serves the built site).
# CORS_ORIGINS=https://campuskart-web.onrender.com

# Force the Secure cookie flag. It is already on when NODE_ENV=production.
# COOKIE_SECURE=true

# Optional e-mail notifications (syllabus Unit 3).
# Leave SMTP_HOST empty to turn them off; the API works exactly the same.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CampusKart <no-reply@campuskart.local>
